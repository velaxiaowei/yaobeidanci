# ==================== DeepSeek API（AI 问答功能用）====================
# 1. 去 https://platform.deepseek.com/ 注册账号
# 2. 在 API Keys 页面创建一个新的 key
# 3. 把 key 粘贴到下面等号后面（不要加引号，不要有空格）
# 4. 保存后重启 Flask 服务器

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== 柯林斯词典 API（可选）====================
# 1. 申请方式：发邮件到 supportservices@harpercollins.co.uk
# 2. 拿到 key 后填到下面
# 3. 如果留空，查词时自动降级用 ECDICT 本地英文释义

COLLINS_API_KEY=

# 代理设置（可选，国内访问柯林斯 API 需要代理）
COLLINS_PROXY=

# ==================== 阿里云短信（找回密码用，可选）====================
# 不配的话，验证码打印到服务器终端（开发模式），不真发短信
# 1. 去 https://dysms.console.aliyun.com/ 开通短信服务
# 2. 创建 AccessKey
# 3. 申请短信签名和模板，模板里要有 ${code} 变量

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
